{
  "name": "@collab-editor/ws-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../web/.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@collab-editor/shared": "workspace:*",
    "jose": "^6.0.0",
    "level": "^6.0.1",
    "lib0": "^0.2.117",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "y-leveldb": "^0.1.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0",
    "y-websocket": "^2.1.0"
  }
}
