// Document content lives in LevelDB on the WS server; Postgres holds identity and room metadata.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js (Prisma adapter) models ---

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdRooms  Room[]       @relation("RoomCreator")
  memberships   RoomMember[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

// Unused under the JWT session strategy; kept so the adapter schema is complete.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Rooms ---

model Room {
  id        String       @id @default(cuid())
  name      String
  language  String       @default("javascript")
  creatorId String
  creator   User         @relation("RoomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members   RoomMember[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([creatorId])
}

enum RoomRole {
  OWNER
  EDITOR
}

// Membership is what grants access to a room; a room ID alone grants nothing.
model RoomMember {
  roomId   String
  userId   String
  role     RoomRole @default(EDITOR)
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

// Rooms whose WS-server document still has to be purged (#48). Written in the room delete's
// transaction; no relation, because the room is already gone.
model RoomPurge {
  roomId        String   @id
  userId        String
  createdAt     DateTime @default(now())
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?

  @@index([nextAttemptAt])
}
