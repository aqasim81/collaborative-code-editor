# === Database ===
DATABASE_URL=                    # PostgreSQL connection string; local Docker Compose: postgresql://collab:collab@localhost:5434/collab_editor

# === Authentication ===
AUTH_SECRET=                     # Auth.js secret, at least 32 chars — generate: openssl rand -hex 32
AUTH_GITHUB_ID=                  # GitHub OAuth App client ID (callback: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_SECRET=              # GitHub OAuth App client secret
AUTH_URL=                        # Optional: public URL of the web app when behind a proxy (e.g., http://localhost:3000)

# === WebSocket Server ===
WS_SERVER_PORT=8080              # Port for WebSocket server
WS_SERVER_URL=                   # Public URL of WS server (e.g., ws://localhost:8080)

# === Next.js ===
NEXT_PUBLIC_WS_URL=              # Client-side WebSocket URL (e.g., ws://localhost:8080)
NEXT_PUBLIC_SITE_URL=            # Public URL of the web app (e.g., http://localhost:3000)
NODE_ENV=development
